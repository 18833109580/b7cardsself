<view class="ai-container"><view class="back-button" bindtap="{{a}}"><text class="back-text">← 返回菜单</text></view><view class="ai-mode-banner"><view class="ai-icon">🤖</view><text class="ai-text">AI对战模式</text><view class="ai-subtitle">挑战人工智能对手</view></view><view class="ai-players-section"><view>AI玩家状态</view><view class="ai-players-container"><view wx:for="{{b}}" wx:for-item="ai" wx:key="f" class="ai-player"><view class="ai-avatar">🤖</view><view class="ai-info"><text class="ai-name">{{ai.a}}</text><text class="ai-cards">手牌: {{ai.b}}张</text><text class="{{['ai-status', ai.d && 'ai-thinking']}}">{{ai.c}}</text></view><view class="ai-level">Lv.{{ai.e}}</view></view></view></view><view class="control-section"><button bindtap="{{c}}" disabled="{{d}}" class="control-btn"><text class="btn-icon">🔄</text> 同步信息 </button><button bindtap="{{e}}" disabled="{{f}}" class="control-btn primary"><text class="btn-icon">🚀</text> 开始AI对战 </button><button bindtap="{{g}}" disabled="{{h}}" class="control-btn secondary"><text class="btn-icon">🔄</text> 重新开始 </button></view><view wx:if="{{i}}" class="turn-section"><view class="{{['turn-indicator', n]}}"><text wx:if="{{j}}" class="turn-text">🎮 轮到您出牌</text><text wx:elif="{{k}}" class="turn-text">🤖 轮到AI玩家 {{l}} 思考中...</text><text wx:else class="turn-text">⏳ 轮到玩家 {{m}} 出牌</text></view></view><view wx:if="{{o}}" class="piles-section"><view>牌堆</view><view class="piles-container"><view wx:for="{{p}}" wx:for-item="pile" wx:key="g"><view wx:if="{{pile.a}}" class="pile-item"><view class="pile"><view class="pile-header"><text class="pile-suit">{{pile.b}}</text><text class="pile-count">{{pile.c}}张</text></view><view class="pile-cards"><view class="pile-sequence"><view wx:for="{{pile.d}}" wx:for-item="entry" wx:key="c" class="{{['pile-card', entry.d, entry.e]}}" style="{{'margin-left:' + entry.f}}"><text class="card-rank">{{entry.a}}</text><text class="card-suit">{{entry.b}}</text></view></view></view><text wx:if="{{pile.e}}" class="pile-player"> 最后出牌: {{pile.f}}</text></view></view></view></view></view><view class="player-section"><view>游戏玩家 ({{q}})</view><view><view wx:for="{{r}}" wx:for-item="item" wx:key="c"> 玩家{{item.a}}: {{item.b}}</view></view></view><view wx:if="{{s}}" class="cards-section"><view>你的手牌 ({{t}}张)</view><view wx:if="{{v}}" class="selected-section"><view>已选牌</view><view class="selected-cards"><view class="card-item"><view class="{{['card', y, 'selected']}}"><text class="card-rank">{{w}}</text><text class="card-suit">{{x}}</text></view></view></view><view class="action-buttons"><button bindtap="{{z}}" class="play-btn">出牌</button><button bindtap="{{A}}" class="clear-btn">取消选择</button></view><view wx:if="{{B}}" class="pass-section"><button bindtap="{{C}}" class="pass-btn" disabled="{{D}}"> Pass </button><text wx:if="{{E}}" class="pass-hint">{{F}}</text></view></view><view class="cards-container"><view wx:for="{{G}}" wx:for-item="card" wx:key="g" class="card-item"><view class="{{['card', card.d, card.e]}}" bindtap="{{card.f}}"><text class="card-rank">{{card.a}}</text><text class="card-suit">{{card.b}}</text><text wx:if="{{card.c}}" class="selected-mark">✓</text></view></view></view></view><view wx:if="{{H}}" class="stats-section"><view>对战统计</view><view class="stats-container"><view class="stat-item"><text class="stat-label">游戏回合</text><text class="stat-value">{{I}}</text></view><view class="stat-item"><text class="stat-label">AI出牌次数</text><text class="stat-value">{{J}}</text></view><view class="stat-item"><text class="stat-label">剩余AI玩家</text><text class="stat-value">{{K}}</text></view><view class="stat-item"><text class="stat-label">AI思考时间</text><text class="stat-value">{{L}}s</text></view></view></view><view wx:if="{{M}}" class="ai-thinking-animation"><view class="thinking-dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view><text class="thinking-text">AI正在思考最佳策略...</text></view></view>