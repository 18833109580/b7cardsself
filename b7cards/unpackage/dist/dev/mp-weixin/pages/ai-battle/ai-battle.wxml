<view class="ai-container"><view class="back-button" bindtap="{{a}}"><text class="back-text">← 返回菜单</text></view><view class="ai-mode-banner"><view class="ai-icon">🤖</view><text class="ai-text">AI对战模式</text><view class="ai-subtitle">挑战人工智能对手</view></view><view wx:if="{{b}}" class="ai-players-section"><view>AI玩家状态</view><view class="ai-players-container"><view wx:for="{{c}}" wx:for-item="ai" wx:key="f" class="ai-player"><view class="ai-avatar">🤖</view><view class="ai-info"><text class="ai-name">{{ai.a}}</text><text class="ai-cards">手牌: {{ai.b}}张</text><text class="{{['ai-status', ai.d && 'ai-thinking']}}">{{ai.c}}</text></view><view class="ai-level">Lv.{{ai.e}}</view></view></view></view><view class="control-section"><button bindtap="{{d}}" disabled="{{e}}" class="control-btn"><text class="btn-icon">🔄</text> 同步信息 </button><button bindtap="{{f}}" disabled="{{g}}" class="control-btn primary"><text class="btn-icon">🚀</text> 开始AI对战 </button><button bindtap="{{h}}" disabled="{{i}}" class="control-btn secondary"><text class="btn-icon">🔄</text> 重新开始 </button></view><view wx:if="{{j}}" class="turn-section"><view class="{{['turn-indicator', o]}}"><text wx:if="{{k}}" class="turn-text">🎮 轮到您出牌</text><text wx:elif="{{l}}" class="turn-text">🤖 轮到AI玩家 {{m}} 思考中...</text><text wx:else class="turn-text">⏳ 轮到玩家 {{n}} 出牌</text></view></view><view wx:if="{{p}}" class="piles-section"><view>牌堆</view><view class="piles-container"><view wx:for="{{q}}" wx:for-item="suit" wx:key="g" class="pile-column"><view wx:if="{{suit.a}}" class="pile-item"><view class="pile"><view class="pile-header"><text class="pile-suit">{{suit.b}}</text><text class="pile-count">{{suit.c}}张</text></view><view class="pile-cards"><view class="pile-sequence"><view wx:for="{{suit.d}}" wx:for-item="entry" wx:key="c" class="{{['pile-card', 'card', entry.d, entry.e]}}"><text class="card-rank">{{entry.a}}</text><text class="card-suit">{{entry.b}}</text></view></view></view><text wx:if="{{suit.e}}" class="pile-player"> 最后出牌: {{suit.f}}</text></view></view></view></view></view><view class="player-section"><view>游戏玩家 ({{r}})</view><view><view wx:for="{{s}}" wx:for-item="item" wx:key="c"> 玩家{{item.a}}: {{item.b}}</view></view></view><view wx:if="{{t}}" class="cards-section"><view>你的手牌 ({{v}}张)</view><view wx:if="{{w}}" class="selected-section"><view>已选牌</view><view class="selected-cards"><view class="card-item"><view class="{{['card', z, 'selected']}}"><text class="card-rank">{{x}}</text><text class="card-suit">{{y}}</text></view></view></view><view class="action-buttons"><button bindtap="{{A}}" class="play-btn">出牌</button><button bindtap="{{B}}" class="clear-btn">取消选择</button></view><view wx:if="{{C}}" class="pass-section"><button bindtap="{{D}}" class="pass-btn" disabled="{{E}}"> Pass </button><text wx:if="{{F}}" class="pass-hint">{{G}}</text></view></view><view class="cards-container"><view wx:if="{{H}}" class="suit-section"><view class="suit-header"><text class="suit-label">♠ 黑桃</text><text class="suit-count">{{I}}张</text></view><view class="suit-cards"><view wx:for="{{J}}" wx:for-item="card" wx:key="g" class="card-item"><view class="{{['card', card.d, card.e]}}" bindtap="{{card.f}}"><text class="card-rank">{{card.a}}</text><text class="card-suit">{{card.b}}</text><text wx:if="{{card.c}}" class="selected-mark">✓</text></view></view></view></view><view wx:if="{{K}}" class="suit-section"><view class="suit-header"><text class="suit-label">♥ 红桃</text><text class="suit-count">{{L}}张</text></view><view class="suit-cards"><view wx:for="{{M}}" wx:for-item="card" wx:key="g" class="card-item"><view class="{{['card', card.d, card.e]}}" bindtap="{{card.f}}"><text class="card-rank">{{card.a}}</text><text class="card-suit">{{card.b}}</text><text wx:if="{{card.c}}" class="selected-mark">✓</text></view></view></view></view><view wx:if="{{N}}" class="suit-section"><view class="suit-header"><text class="suit-label">♣ 梅花</text><text class="suit-count">{{O}}张</text></view><view class="suit-cards"><view wx:for="{{P}}" wx:for-item="card" wx:key="g" class="card-item"><view class="{{['card', card.d, card.e]}}" bindtap="{{card.f}}"><text class="card-rank">{{card.a}}</text><text class="card-suit">{{card.b}}</text><text wx:if="{{card.c}}" class="selected-mark">✓</text></view></view></view></view><view wx:if="{{Q}}" class="suit-section"><view class="suit-header"><text class="suit-label">♦ 方片</text><text class="suit-count">{{R}}张</text></view><view class="suit-cards"><view wx:for="{{S}}" wx:for-item="card" wx:key="g" class="card-item"><view class="{{['card', card.d, card.e]}}" bindtap="{{card.f}}"><text class="card-rank">{{card.a}}</text><text class="card-suit">{{card.b}}</text><text wx:if="{{card.c}}" class="selected-mark">✓</text></view></view></view></view></view></view><view wx:if="{{T}}" class="stats-section"><view>对战统计</view><view class="stats-container"><view class="stat-item"><text class="stat-label">游戏回合</text><text class="stat-value">{{U}}</text></view><view class="stat-item"><text class="stat-label">AI出牌次数</text><text class="stat-value">{{V}}</text></view><view class="stat-item"><text class="stat-label">剩余AI玩家</text><text class="stat-value">{{W}}</text></view><view class="stat-item"><text class="stat-label">AI思考时间</text><text class="stat-value">{{X}}s</text></view></view></view><view wx:if="{{Y}}" class="ai-thinking-animation"><view class="thinking-dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view><text class="thinking-text">AI正在思考最佳策略...</text></view></view>